{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @snakeland/api build",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @snakeland/api db:migrate:prod"],
    "startCommand": "pnpm --filter @snakeland/api start",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
