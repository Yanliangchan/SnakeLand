NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://snake:snake@localhost:5432/snakeland
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public origin where browsers reach /api/auth. With the web app proxying /api and /v1
# (the default setup) that is the web origin; with a shared-domain setup, the API's own origin.
API_URL=http://localhost:3000
# Browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:3000

# Production only: parent domain shared by app. and api. subdomains (e.g. example.com).
# COOKIE_DOMAIN=example.com

# Header the edge sets with the client IP (Railway: x-real-ip). Unset locally.
# CLIENT_IP_HEADER=x-real-ip
# Alternatively, the number of trusted X-Forwarded-For hops.
TRUST_PROXY_HOPS=0

# /admin console password, stored only as an scrypt hash. Unset disables /admin.
# Generate: printf '%s' 'your-password' | pnpm --filter @snakeland/api admin:hash
# ADMIN_PASSWORD_HASH=
# Optional second factor for /admin (base32): admin:hash -- --totp prints one.
# ADMIN_TOTP_SECRET=
