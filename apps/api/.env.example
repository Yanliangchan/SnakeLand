NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://snake:snake@localhost:5432/snakeland
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public origin of this API and the browser origins allowed to call it.
API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000

# Production only: parent domain shared by app. and api. subdomains (e.g. example.com).
# COOKIE_DOMAIN=example.com

# Reverse-proxy hops in front of the API (Railway: 1). 0 locally.
TRUST_PROXY_HOPS=0
